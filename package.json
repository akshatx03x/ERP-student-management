{
  "name": "school-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:cloud": "APP_MODE=cloud next dev --turbopack",
    "dev:offline": "APP_MODE=offline next dev --turbopack",
    "build": "node -e \"const p=require('path'),f=require('fs'),r=p.resolve(__dirname),n=p.join(r,'.next');try{if(f.existsSync(n))f.rmSync(n,{recursive:true,force:true,maxRetries:5,retryDelay:200});}catch(e){}\" && next build && node -e \"const p=require('path'),f=require('fs'),r=p.resolve(__dirname),s=p.join(r,'.next/static'),sd=p.join(r,'.next/standalone/.next/static'),pb=p.join(r,'public'),pd=p.join(r,'.next/standalone/public');if(f.existsSync(s))f.cpSync(s,sd,{recursive:true,dereference:true});if(f.existsSync(pb))f.cpSync(pb,pd,{recursive:true,dereference:true});const nm=p.join(r,'.next/standalone/node_modules');if(f.existsSync(nm)){const tmp=p.join(r,'.next/nm_deref');f.cpSync(nm,tmp,{recursive:true,dereference:true});f.rmSync(nm,{recursive:true,force:true});f.renameSync(tmp,nm);}\"",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "desktop:start": "cd desktop && npm start",
    "desktop:build": "npm run build && cd desktop && npm run dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-prisma-types": "^3.3.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
