{
  "appId": "com.vidyanjali.schoolerp",
  "productName": "SchoolERP Desktop",
  "copyright": "Copyright © 2026 Vidyanjali Public School",
  "compression": "normal",
  "publish": null,
  "directories": {
    "output": "../dist/build",
    "buildResources": "assets",
    "app": "."
  },
  "files": [
    "dist/**/*",
    "package.json",
    {
      "from": "../node_modules/.prisma",
      "to": "node_modules/.prisma"
    },
    "!**/*.ts",
    "!**/src/**",
    "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}"
  ],
  "extraFiles": [
    { "from": "Update.bat", "to": "Update.bat" },
    { "from": "Update.ps1", "to": "Update.ps1" }
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/schema-engine-windows.exe"
  ],
  "extraResources": [
    {
      "from": "../.next/standalone",
      "to": "app"
    },
    {
      "from": "../dist/seed",
      "to": "app/dist/seed"
    },
    {
      "from": "../prisma",
      "to": "prisma"
    },
    {
      "from": "../node_modules/better-auth",
      "to": "app/node_modules/better-auth"
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SchoolERP Desktop",
    "runAfterFinish": true,
    "artifactName": "SchoolERP_Setup.exe",
    "include": "installer/nsis-installer.nsh"
  }
}