generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  name                 String
  code                 String                @unique
  academicSessions     AcademicSession[]
  auditLogs            AuditLog[]
  classes              Class[]
  documents            Document[]
  families             Family[]
  feeDiscounts         FeeDiscount[]
  feeHeads             FeeHead[]
  feeLateRules         FeeLateRule[]
  gradeScales          GradeScale[]
  guardians            Guardian[]
  holidays             Holiday[]
  importJobs           ImportJob[]
  notices              Notice[]
  notificationChannels NotificationChannel[]
  branding             SchoolBranding?
  staffProfiles        StaffProfile[]
  students             Student[]
  subjects             Subject[]
  users                User[]
}

model SchoolBranding {
  id                           String   @id @default(cuid())
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  schoolId                     String   @unique
  schoolName                   String
  address                      String?
  phone                        String?
  email                        String?
  website                      String?
  principalName                String?
  logoDocumentId               String?
  principalSignatureDocumentId String?
  schoolStampDocumentId        String?
  qrCodeDocumentId             String?
  receiptFooter                String?
  reportCardFooter             String?
  school                       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model User {
  id                          String                 @id @default(cuid())
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  name                        String
  email                       String                 @unique
  emailVerified               Boolean                @default(false)
  image                       String?
  role                        Role                   @default("STUDENT")
  isActive                    Boolean                @default(true)
  mustChangePassword          Boolean                @default(false)
  loginIdentifier             String?
  schoolId                    String?
  staffProfileId              String?                @unique
  studentId                   String?                @unique
  accounts                    Account[]
  admissionsReviewed          AdmissionApplication[] @relation("AdmissionReviewer")
  advanceTransactionsRecorded AdvanceTransaction[]   @relation("AdvanceTxRecorder")
  attendanceMarked            AttendanceRecord[]     @relation("AttendanceMarker")
  auditLogs                   AuditLog[]
  paymentsRecorded            FamilyPayment[]        @relation("PaymentRecorder")
  discountsApproved           FeeDiscount[]          @relation("DiscountApprover")
  rulesUpdated                FeeLateRule[]          @relation("RuleUpdater")
  rulesCreated                FeeLateRule[]          @relation("RuleCreator")
  importJobs                  ImportJob[]
  leavesApproved              LeaveRequest[]         @relation("LeaveApprover")
  marksEntered                MarkEntry[]            @relation("MarksEnterer")
  noticesCreated              Notice[]               @relation("NoticeCreator")
  promotionBatchesCreated     PromotionBatch[]       @relation("PromotionBatchCreator")
  promotions                  PromotionHistory[]     @relation("PromotionActor")
  sessions                    Session[]
  studentExitsCreated         StudentExit[]          @relation("ExitRecordCreator")
  finesWaived                 StudentFeeFine[]       @relation("FineWaiver")
  student                     Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffProfile                StaffProfile?          @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  school                      School?                @relation(fields: [schoolId], references: [id])
  userPermissions             UserPermission[]

  @@unique([schoolId, loginIdentifier])
  @@index([schoolId, role])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
}

model Permission {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resource        String
  action          String
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([resource])
}

model RolePermission {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role
  permissionId String
  allowed      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userId       String
  permissionId String
  allowed      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model StaffProfile {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  schoolId                String
  employeeCode            String
  fullName                String
  phone                   String?
  designation             String?
  role                    Role
  isActive                Boolean                  @default(true)
  classTeacherAssignments ClassTeacherAssignment[]
  homework                Homework[]
  leaveRequests           LeaveRequest[]
  school                  School                   @relation(fields: [schoolId], references: [id])
  timetableSlots          TimetableSlot[]
  user                    User?

  @@unique([schoolId, employeeCode])
  @@index([schoolId, fullName])
}

model AcademicSession {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  schoolId                String
  name                    String
  startDate               DateTime
  endDate                 DateTime
  status                  SessionStatus            @default("DRAFT")
  isCurrent               Boolean                  @default(false)
  school                  School                   @relation(fields: [schoolId], references: [id])
  admissions              AdmissionApplication[]
  attendanceRecords       AttendanceRecord[]
  classSubjects           ClassSubject[]
  classTeacherAssignments ClassTeacherAssignment[]
  exams                   Exam[]
  examTypes               ExamType[]
  feeDiscounts            FeeDiscount[]
  feeLateRules            FeeLateRule[]
  feeStructures           FeeStructure[]
  homework                Homework[]
  promotionBatchesTo      PromotionBatch[]         @relation("BatchToSession")
  promotionBatchesFrom    PromotionBatch[]         @relation("BatchFromSession")
  promotionsTo            PromotionHistory[]       @relation("ToSession")
  promotionsFrom          PromotionHistory[]       @relation("FromSession")
  reportCards             ReportCard[]
  enrollments             StudentEnrollment[]
  studentFees             StudentFee[]
  timetableSlots          TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Class {
  id             String                 @id @default(cuid())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  schoolId       String
  name           String
  sortOrder      Int                    @default(0)
  admissions     AdmissionApplication[]
  school         School                 @relation(fields: [schoolId], references: [id])
  classSubjects  ClassSubject[]
  exams          Exam[]
  feeStructures  FeeStructure[]
  promotionsTo   PromotionHistory[]     @relation("ToClass")
  promotionsFrom PromotionHistory[]     @relation("FromClass")
  sections       Section[]
  enrollments    StudentEnrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model Section {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  classId                 String
  name                    String
  classTeacherAssignments ClassTeacherAssignment[]
  homework                Homework[]
  promotionsTo            PromotionHistory[]       @relation("ToSection")
  promotionsFrom          PromotionHistory[]       @relation("FromSection")
  class                   Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments             StudentEnrollment[]
  timetableSlots          TimetableSlot[]

  @@unique([classId, name])
}

model Subject {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  schoolId       String
  name           String
  code           String
  classSubjects  ClassSubject[]
  examSubjects   ExamSubject[]
  homework       Homework[]
  school         School          @relation(fields: [schoolId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
}

model ClassSubject {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessionId String
  classId   String
  subjectId String
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([sessionId, classId, subjectId])
}

model ClassTeacherAssignment {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessionId      String
  sectionId      String
  staffProfileId String
  staffProfile   StaffProfile    @relation(fields: [staffProfileId], references: [id])
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sectionId])
  @@index([staffProfileId, sessionId])
}

model Family {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  schoolId              String
  familyCode            String?
  fatherName            String?
  motherName            String?
  guardianName          String?
  primaryPhone          String?
  secondaryPhone        String?
  email                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  pincode               String?
  resAddressLine1       String?
  resAddressLine2       String?
  resCity               String?
  resState              String?
  resPincode            String?
  sameAsResidential     Boolean                @default(true)
  permAddressLine1      String?
  permAddressLine2      String?
  permCity              String?
  permState             String?
  permPincode           String?
  declarationAccepted   Boolean                @default(false)
  declarationDate       DateTime?
  declarationParentName String?
  admissions            AdmissionApplication[]
  advanceTransactions   AdvanceTransaction[]
  school                School                 @relation(fields: [schoolId], references: [id])
  advanceWallet         FamilyAdvanceWallet?
  payments              FamilyPayment[]
  guardians             Guardian[]
  students              Student[]

  @@unique([schoolId, familyCode])
  @@index([schoolId, fatherName])
  @@index([schoolId, motherName])
  @@index([schoolId, primaryPhone])
}

model Guardian {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  schoolId       String
  familyId       String?
  fullName       String
  gender         Gender?
  phone          String?
  secondaryPhone String?
  email          String?
  qualification  String?
  isWorking      Boolean?
  occupation     String?
  designation    String?
  annualIncome   Decimal?
  officeAddress  String?
  employerName   String?
  aadhaarNumber  String?
  panNumber      String?
  userId         String?           @unique
  school         School            @relation(fields: [schoolId], references: [id])
  family         Family?           @relation(fields: [familyId], references: [id])
  students       StudentGuardian[]

  @@index([schoolId, phone])
  @@index([schoolId, fullName])
}

model StudentGuardian {
  id                 String               @id @default(cuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  studentId          String
  guardianId         String
  relationshipType   GuardianRelationship @default("OTHER")
  isPrimaryContact   Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  isFeePayer         Boolean              @default(false)
  hasCustody         Boolean              @default(true)
  canPickUp          Boolean              @default(true)
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian           Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
}

model Student {
  id                   String                 @id @default(cuid())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  schoolId             String
  familyId             String
  admissionNo          String
  firstName            String
  middleName           String?
  lastName             String?
  fullName             String
  dateOfBirth          DateTime
  gender               Gender?
  bloodGroup           String?
  aadhaar              String?
  religion             String?
  category             StudentCategory?
  apaarId              String?
  penId                String?
  previousSchoolName   String?
  previousClass        String?
  tcNumber             String?
  tcDate               DateTime?
  transportRequired    Boolean                @default(false)
  transportPickupPoint String?
  admissionDate        DateTime?              @default(now())
  photoDocumentId      String?
  photoUrl             String?
  status               StudentStatus          @default("ACTIVE")
  admissions           AdmissionApplication[]
  advanceTransactions  AdvanceTransaction[]
  attendance           AttendanceRecord[]
  feeDiscounts         FeeDiscount[]
  feeAllocations       FeePaymentAllocation[]
  leaveRequests        LeaveRequest[]
  markEntries          MarkEntry[]
  promotions           PromotionHistory[]
  reportCards          ReportCard[]
  school               School                 @relation(fields: [schoolId], references: [id])
  family               Family                 @relation(fields: [familyId], references: [id])
  enrollments          StudentEnrollment[]
  exitInfo             StudentExit?
  studentFees          StudentFee[]
  guardians            StudentGuardian[]
  medical              StudentMedical?
  user                 User?

  @@unique([schoolId, admissionNo])
  @@index([schoolId, fullName])
  @@index([familyId])
  @@index([schoolId, status])
}

model StudentMedical {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  studentId  String   @unique
  allergies  String?
  conditions String?
  notes      String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentEnrollment {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  studentId        String
  sessionId        String
  classId          String
  sectionId        String
  rollNo           String?
  house            String?
  status           EnrollmentStatus @default("ACTIVE")
  promotionBatchId String?
  promotionBatch   PromotionBatch?  @relation(fields: [promotionBatchId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session          AcademicSession  @relation(fields: [sessionId], references: [id])
  section          Section          @relation(fields: [sectionId], references: [id])
  class            Class            @relation(fields: [classId], references: [id])

  @@unique([studentId, sessionId])
  @@index([sessionId, sectionId])
  @@index([sessionId, classId])
}

model StudentExit {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  studentId   String     @unique
  leavingDate DateTime
  reason      ExitReason @default("TRANSFERRED")
  tcNumber    String?
  tcDate      DateTime?
  remarks     String?
  createdById String?
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation("ExitRecordCreator", fields: [createdById], references: [id])

  @@index([leavingDate])
}

model PromotionBatch {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  fromSessionId String
  toSessionId   String
  createdById   String?
  status        PromotionBatchStatus @default("COMPLETED")
  toSession     AcademicSession      @relation("BatchToSession", fields: [toSessionId], references: [id])
  fromSession   AcademicSession      @relation("BatchFromSession", fields: [fromSessionId], references: [id])
  createdBy     User?                @relation("PromotionBatchCreator", fields: [createdById], references: [id])
  enrollments   StudentEnrollment[]

  @@index([fromSessionId, toSessionId])
}

model PromotionHistory {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  studentId     String
  fromSessionId String
  toSessionId   String
  fromClassId   String
  toClassId     String
  fromSectionId String?
  toSectionId   String?
  promotedAt    DateTime        @default(now())
  byUserId      String?
  notes         String?
  toSession     AcademicSession @relation("ToSession", fields: [toSessionId], references: [id])
  toSection     Section?        @relation("ToSection", fields: [toSectionId], references: [id])
  toClass       Class           @relation("ToClass", fields: [toClassId], references: [id])
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSession   AcademicSession @relation("FromSession", fields: [fromSessionId], references: [id])
  fromSection   Section?        @relation("FromSection", fields: [fromSectionId], references: [id])
  fromClass     Class           @relation("FromClass", fields: [fromClassId], references: [id])
  byUser        User?           @relation("PromotionActor", fields: [byUserId], references: [id])

  @@index([studentId])
}

model AdmissionApplication {
  id                    String           @id @default(cuid())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  sessionId             String
  familyId              String?
  studentId             String?
  applicantName         String
  dateOfBirth           DateTime
  gender                Gender?
  religion              String?
  category              StudentCategory?
  aadhaar               String?
  apaarId               String?
  penId                 String?
  appliedClassId        String
  fatherName            String?
  fatherQualification   String?
  fatherOccupation      String?
  fatherDesignation     String?
  fatherAnnualIncome    Decimal?
  fatherOfficeAddress   String?
  fatherPhone           String?
  fatherAadhaar         String?
  motherName            String?
  motherQualification   String?
  motherIsWorking       Boolean?
  motherOccupation      String?
  motherDesignation     String?
  motherAnnualIncome    Decimal?
  motherOfficeAddress   String?
  motherPhone           String?
  motherAadhaar         String?
  guardianName          String?
  phone                 String?
  address               String?
  resAddressLine1       String?
  resAddressLine2       String?
  resCity               String?
  resState              String?
  resPincode            String?
  sameAsResidential     Boolean          @default(true)
  permAddressLine1      String?
  permAddressLine2      String?
  permCity              String?
  permState             String?
  permPincode           String?
  previousSchoolName    String?
  previousClass         String?
  tcNumber              String?
  tcDate                DateTime?
  transportRequired     Boolean          @default(false)
  transportPickupPoint  String?
  declarationAccepted   Boolean          @default(false)
  declarationDate       DateTime?
  declarationParentName String?
  admissionDate         DateTime?
  photoDocumentId       String?
  photoUrl              String?
  status                AdmissionStatus  @default("PENDING")
  admissionNo           String?
  remarks               String?
  reviewedById          String?
  reviewedAt            DateTime?
  student               Student?         @relation(fields: [studentId], references: [id])
  session               AcademicSession  @relation(fields: [sessionId], references: [id])
  reviewedBy            User?            @relation("AdmissionReviewer", fields: [reviewedById], references: [id])
  family                Family?          @relation(fields: [familyId], references: [id])
  appliedClass          Class            @relation(fields: [appliedClassId], references: [id])

  @@index([sessionId, status])
  @@index([admissionNo])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  sessionId  String
  studentId  String
  date       DateTime
  status     AttendanceStatus
  remarks    String?
  markedById String?
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    AcademicSession  @relation(fields: [sessionId], references: [id])
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([sessionId, date])
}

model LeaveRequest {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requesterType  LeaveRequesterType
  studentId      String?
  staffProfileId String?
  fromDate       DateTime
  toDate         DateTime
  reason         String
  status         LeaveStatus        @default("PENDING")
  approvedById   String?
  reviewedAt     DateTime?
  remarks        String?
  student        Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile?      @relation(fields: [staffProfileId], references: [id])
  approvedBy     User?              @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([status, fromDate])
  @@index([studentId])
  @@index([staffProfileId])
}

model Holiday {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  schoolId    String
  date        DateTime
  name        String
  description String?
  type        HolidayType @default("SCHOOL")
  school      School      @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, date])
  @@index([schoolId, date])
}

model TimetableSlot {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessionId      String
  sectionId      String
  dayOfWeek      DayOfWeek
  periodNumber   Int
  startTime      String
  endTime        String
  subjectId      String
  staffProfileId String
  subject        Subject         @relation(fields: [subjectId], references: [id])
  staffProfile   StaffProfile    @relation(fields: [staffProfileId], references: [id])
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sectionId, dayOfWeek, periodNumber])
  @@index([staffProfileId, sessionId, dayOfWeek])
}

model Homework {
  id               String               @id @default(cuid())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessionId        String
  sectionId        String
  subjectId        String
  title            String
  description      String?
  dueDate          DateTime
  createdByStaffId String
  subject          Subject              @relation(fields: [subjectId], references: [id])
  session          AcademicSession      @relation(fields: [sessionId], references: [id])
  section          Section              @relation(fields: [sectionId], references: [id])
  createdByStaff   StaffProfile         @relation(fields: [createdByStaffId], references: [id])
  attachments      HomeworkAttachment[]

  @@index([sectionId, dueDate])
  @@index([createdByStaffId])
}

model HomeworkAttachment {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  homeworkId String
  documentId String   @unique
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ExamType {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessionId String
  name      String
  exams     Exam[]
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, name])
}

model Exam {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessionId   String
  examTypeId  String
  classId     String
  name        String
  startDate   DateTime?
  endDate     DateTime?
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  examType    ExamType        @relation(fields: [examTypeId], references: [id])
  class       Class           @relation(fields: [classId], references: [id])
  subjects    ExamSubject[]
  reportCards ReportCard[]

  @@index([sessionId, classId])
}

model ExamSubject {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  examId      String
  subjectId   String
  maxMarks    Decimal
  passMarks   Decimal
  subject     Subject     @relation(fields: [subjectId], references: [id])
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  markEntries MarkEntry[]

  @@unique([examId, subjectId])
}

model MarkEntry {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  examSubjectId String
  studentId     String
  marksObtained Decimal
  grade         String?
  remarks       String?
  enteredById   String?
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enteredBy     User?       @relation("MarksEnterer", fields: [enteredById], references: [id])

  @@unique([examSubjectId, studentId])
  @@index([studentId])
}

model GradeScale {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  schoolId   String
  minPercent Decimal
  maxPercent Decimal
  grade      String
  remarks    String?
  school     School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model ReportCard {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  studentId   String
  sessionId   String
  examId      String?
  snapshot    Json
  publishedAt DateTime?
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  exam        Exam?           @relation(fields: [examId], references: [id])

  @@index([studentId, sessionId])
}

model FeeHead {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  schoolId       String
  name           String
  frequency      FeeFrequency       @default("MONTHLY")
  description    String?
  isActive       Boolean            @default(true)
  feeDiscounts   FeeDiscount[]
  school         School             @relation(fields: [schoolId], references: [id])
  structureItems FeeStructureItem[]
  studentFees    StudentFee[]

  @@unique([schoolId, name])
}

model FeeStructure {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sessionId String
  classId   String
  name      String
  session   AcademicSession    @relation(fields: [sessionId], references: [id])
  class     Class              @relation(fields: [classId], references: [id])
  items     FeeStructureItem[]

  @@unique([sessionId, classId, name])
}

model FeeStructureItem {
  id             String                  @id @default(cuid())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  feeStructureId String
  feeHeadId      String
  amount         Decimal
  feeStructure   FeeStructure            @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead        FeeHead                 @relation(fields: [feeHeadId], references: [id])
  months         FeeStructureItemMonth[]

  @@unique([feeStructureId, feeHeadId])
}

model FeeStructureItemMonth {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  feeStructureItemId String
  month              FeeMonth
  feeStructureItem   FeeStructureItem @relation(fields: [feeStructureItemId], references: [id], onDelete: Cascade)

  @@unique([feeStructureItemId, month])
  @@index([feeStructureItemId])
}

model StudentFee {
  id                  String                 @id @default(cuid())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  studentId           String
  feeHeadId           String
  sessionId           String
  amount              Decimal
  discountAmount      Decimal                @default(0)
  month               FeeMonth?
  dueYear             Int?
  dueDate             DateTime?
  status              StudentFeeStatus       @default("PENDING")
  remarks             String?
  advanceTransactions AdvanceTransaction[]
  allocations         FeePaymentAllocation[]
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session             AcademicSession        @relation(fields: [sessionId], references: [id])
  feeHead             FeeHead                @relation(fields: [feeHeadId], references: [id])
  fine                StudentFeeFine?

  @@unique([studentId, sessionId, feeHeadId, month])
  @@index([studentId, sessionId, status])
  @@index([sessionId, status])
  @@index([studentId, month])
}

model FamilyPayment {
  id                  String                 @id @default(cuid())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  familyId            String
  amount              Decimal
  method              PaymentMethod
  referenceNo         String?
  paidAt              DateTime               @default(now())
  receiptNo           String                 @unique
  notes               String?
  recordedById        String?
  advanceTransactions AdvanceTransaction[]
  recordedBy          User?                  @relation("PaymentRecorder", fields: [recordedById], references: [id])
  family              Family                 @relation(fields: [familyId], references: [id])
  allocations         FeePaymentAllocation[]
  receipt             FeeReceipt?

  @@index([familyId, paidAt])
}

model FeePaymentAllocation {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  paymentId        String?
  studentId        String
  studentFeeId     String?
  studentFeeFineId String?
  amount           Decimal
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFeeFine   StudentFeeFine? @relation(fields: [studentFeeFineId], references: [id], onDelete: Cascade)
  studentFee       StudentFee?     @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  payment          FamilyPayment?  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([paymentId])
  @@index([studentFeeFineId])
}

model FeeReceipt {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paymentId String        @unique
  snapshot  Json
  payment   FamilyPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model FamilyAdvanceWallet {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  familyId     String               @unique
  balance      Decimal              @default(0)
  transactions AdvanceTransaction[]
  family       Family               @relation(fields: [familyId], references: [id])

  @@index([familyId])
}

model AdvanceTransaction {
  id                 String                 @id @default(cuid())
  createdAt          DateTime               @default(now())
  walletId           String
  familyId           String
  paymentId          String?
  targetStudentId    String?
  targetStudentFeeId String?
  type               AdvanceTransactionType
  amount             Decimal
  balanceBefore      Decimal
  balanceAfter       Decimal
  reason             String
  remarks            String?
  recordedById       String?
  recordedBy         User?                  @relation("AdvanceTxRecorder", fields: [recordedById], references: [id])
  targetStudentFee   StudentFee?            @relation(fields: [targetStudentFeeId], references: [id])
  targetStudent      Student?               @relation(fields: [targetStudentId], references: [id])
  payment            FamilyPayment?         @relation(fields: [paymentId], references: [id])
  family             Family                 @relation(fields: [familyId], references: [id])
  wallet             FamilyAdvanceWallet    @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([familyId, createdAt])
  @@index([paymentId])
  @@index([targetStudentFeeId])
  @@index([targetStudentId])
}

model FeeDiscount {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  schoolId      String
  studentId     String
  sessionId     String
  feeHeadId     String?
  month         FeeMonth?
  discountType  DiscountType
  value         Decimal
  category      DiscountCategory
  reason        String
  remarks       String?
  approvedById  String?
  approvedAt    DateTime?
  effectiveFrom DateTime         @default(now())
  effectiveTill DateTime?
  status        DiscountStatus   @default("ACTIVE")
  approvedBy    User?            @relation("DiscountApprover", fields: [approvedById], references: [id])
  feeHead       FeeHead?         @relation(fields: [feeHeadId], references: [id])
  session       AcademicSession  @relation(fields: [sessionId], references: [id])
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school        School           @relation(fields: [schoolId], references: [id])

  @@index([studentId, sessionId, status])
  @@index([schoolId])
}

model FeeLateRule {
  id                 String                 @id @default(cuid())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  schoolId           String
  sessionId          String
  name               String
  isActive           Boolean                @default(true)
  effectiveFrom      DateTime               @default(now())
  effectiveTill      DateTime?
  graceDays          Int                    @default(0)
  calculationType    LateFeeCalculationType
  fixedAmount        Decimal?
  percentage         Decimal?
  applyPerDay        Decimal?
  applyPerMonth      Decimal?
  maxFine            Decimal?
  applicableFeeHeads String?
  priority           Int                    @default(0)
  createdByUserId    String?
  updatedByUserId    String?
  updatedBy          User?                  @relation("RuleUpdater", fields: [updatedByUserId], references: [id])
  createdBy          User?                  @relation("RuleCreator", fields: [createdByUserId], references: [id])
  session            AcademicSession        @relation(fields: [sessionId], references: [id])
  school             School                 @relation(fields: [schoolId], references: [id])
  fines              StudentFeeFine[]

  @@index([schoolId, sessionId, isActive])
}

model StudentFeeFine {
  id               String                 @id @default(cuid())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  studentFeeId     String                 @unique
  lateRuleId       String?
  generatedOn      DateTime               @default(now())
  calculatedAmount Decimal
  waivedAmount     Decimal                @default(0)
  finalAmount      Decimal
  paidAmount       Decimal                @default(0)
  status           StudentFeeFineStatus   @default("ACTIVE")
  remarks          String?
  waivedById       String?
  waivedAt         DateTime?
  waiveReason      String?
  allocations      FeePaymentAllocation[]
  waivedBy         User?                  @relation("FineWaiver", fields: [waivedById], references: [id])
  lateRule         FeeLateRule?           @relation(fields: [lateRuleId], references: [id])
  studentFee       StudentFee             @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
  @@index([status])
}

model Document {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  schoolId           String
  ownerType          DocumentOwnerType
  ownerId            String
  type               DocumentType        @default("OTHER")
  fileName           String
  mimeType           String
  sizeBytes          Int
  checksum           String
  school             School              @relation(fields: [schoolId], references: [id])
  blob               DocumentBlob?
  homeworkAttachment HomeworkAttachment?

  @@index([schoolId, ownerType, ownerId])
  @@index([type])
}

model DocumentBlob {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  documentId String   @unique
  data       Bytes
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Notice {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  schoolId    String
  title       String
  body        String
  audience    NoticeAudience @default("ALL")
  publishedAt DateTime?
  createdById String?
  isActive    Boolean        @default(true)
  school      School         @relation(fields: [schoolId], references: [id])
  createdBy   User?          @relation("NoticeCreator", fields: [createdById], references: [id])

  @@index([schoolId, publishedAt])
}

model NotificationChannel {
  id        String                  @id @default(cuid())
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  schoolId  String
  type      NotificationChannelType
  enabled   Boolean                 @default(false)
  config    Json?
  school    School                  @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  schoolId   String?
  userId     String?
  action     String
  module     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])
  school     School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model ImportJob {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  schoolId     String
  type         ImportType
  status       ImportJobStatus @default("PENDING")
  successCount Int             @default(0)
  failCount    Int             @default(0)
  errorReport  Json?
  preview      Json?
  uploadedById String?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id])
  school       School          @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
}

model SystemCounter {
  id        String   @id
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

